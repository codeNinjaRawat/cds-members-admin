{
  "name": "isgh-admin",
  "version": "0.1.0",
  "private": true,
  "description": "ISGH Admin – 'working on glass'. Controls the website (content, menus, theme, branding, giving, membership rules, feature flags). Demo: publishes to ../.demo-store (no API).",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "dev:webpack": "next dev -p 3001",
    "fast": "next build && next start -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20.9.0" }
}
