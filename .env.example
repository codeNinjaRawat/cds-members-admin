# ---- ISGH admin (copy to .env.local) ----
# The public website the live preview shows (and where "Open site" links go)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# DEMO STORE (no BE yet): "Publish" writes JSON here; the website reads the same folder in mock mode.
# Default: ../.demo-store (next to web/ and admin/). Set to "off" to disable publishing.
ISGH_DEMO_STORE=../.demo-store

# Live mode: ISGH_USE_MOCK_API=false → sign-in (/sign-in), documents and the organization panel use the API.
ISGH_USE_MOCK_API=true
ISGH_API_URL=http://localhost:4330
# the same long secret as the API's EDGE_KEY
MS_EDGE_KEY=
