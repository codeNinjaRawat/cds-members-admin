# ---- ISGH admin – PREVIEW server (https://member-admin.nextgrow.pro) ----
# Used by `npm run build` and `npm run start`. Values already set in the shell win over this file.
NEXT_PUBLIC_ADMIN_URL=https://member-admin.nextgrow.pro
NEXT_PUBLIC_WEBSITE_URL=https://member-web.nextgrow.pro
# Publish writes here; the website reads the same folder (both apps must be on the same server, side by side)
ISGH_DEMO_STORE=../.demo-store
# Sign-in for the preview (HTTP Basic). Set the PASSWORD on the server only – never commit it:
#   ISGH_ADMIN_PREVIEW_USER=isgh
#   ISGH_ADMIN_PREVIEW_PASSWORD=********
