# ---- ISGH admin on the server (https://member-admin.nextgrow.pro) – LIVE: talks to the API ----
# Used by `npm run build` and `npm run start` (rebuild after any change here). Values set in the shell win.
NEXT_PUBLIC_ADMIN_URL=https://member-admin.nextgrow.pro
NEXT_PUBLIC_WEBSITE_URL=https://member-web.nextgrow.pro
# The API on the same server (BE, pm2 membership-api). Sign-in: the admin's own page (email code).
ISGH_USE_MOCK_API=false
ISGH_API_URL=http://127.0.0.1:4330
ISGH_API_TIMEOUT_MS=15000
# MS_EDGE_KEY = the API's EDGE_KEY – NOT here (this file is in git): put it in admin/.env.production.local on the server.
# Optional extra lock while testing (HTTP Basic before the sign-in page) – set on the server only, never in git:
#   ISGH_ADMIN_PREVIEW_USER=isgh
#   ISGH_ADMIN_PREVIEW_PASSWORD=…
